# DocExpire backend configuration
# This example is intentionally local-first: SQLite + filesystem storage + fakeredis + eager jobs.
# Copy to backend/.env and adjust values as needed.

# Application
APP_ENV=development
APP_DEBUG=False
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=local-dev-app-secret-key-change-me-1234
SERVICE_NAME=docexpire-api
SERVICE_VERSION=2.1.0

# Database
DATABASE_URL=sqlite:///./docexpire.db

# JWT
JWT_SECRET_KEY=local-dev-jwt-secret-key-change-me-1234
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Frontend URL
FRONTEND_URL=http://localhost:5173

# CORS / Hosts
CORS_ALLOW_ORIGINS=http://localhost:5173
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type
CORS_ALLOW_CREDENTIALS=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Redis / Queue
# Local mode can use fakeredis with eager execution. Production should use a real Redis URL and set RQ_ASYNC=True.
REDIS_URL=fakeredis://
RQ_QUEUE_NAME=docexpire
RQ_JOB_TIMEOUT=600
RQ_RESULT_TTL=3600
RQ_ASYNC=False

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Object storage
# Local mode uses filesystem storage rooted at STORAGE_FILESYSTEM_ROOT.
# Production can switch to s3, gcs, or azure.
STORAGE_PROVIDER=filesystem
STORAGE_FILESYSTEM_ROOT=./local_storage
STORAGE_BUCKET=
STORAGE_PREFIX=uploads
STORAGE_REGION=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Azure Storage (optional when STORAGE_PROVIDER=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_ACCOUNT_KEY=

# Temp dir for OCR/downloads
TEMP_DIR_OVERRIDE=./tmp

# File Upload Settings
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg

# Alerts
ALERT_DAYS=7
ALERTS_ENABLED=True
ALERT_INTERVAL_HOURS=24

# Secure headers
SECURE_HEADERS_ENABLED=True
SECURE_HEADERS_HSTS_SECONDS=0
SECURE_HEADERS_CSP=default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'

# Email
# Leave blank in local mode to use manual verification links instead of SMTP delivery.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# Cloud OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/cloud/google_drive/callback

DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=http://127.0.0.1:8000/cloud/dropbox/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://127.0.0.1:8000/cloud/onedrive/callback
MICROSOFT_TENANT_ID=common

# AI analysis (optional)
ANTHROPIC_API_KEY=

# Token encryption
# Optional in development. Required in staging/production.
TOKEN_ENCRYPTION_KEY=

# Production overrides checklist
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg2://...
# REDIS_URL=redis://...
# RQ_ASYNC=True
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=...
# APP_SECRET_KEY=<32+ char secret>
# JWT_SECRET_KEY=<32+ char secret>
# TOKEN_ENCRYPTION_KEY=<Fernet key>
# SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASSWORD/FROM_EMAIL=<configured>
# SECURE_HEADERS_HSTS_SECONDS=31536000
